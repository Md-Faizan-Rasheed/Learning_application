# ============================================================
# Islamic Learning Game — root .gitignore
# Covers: secrets, Python/FastAPI backend, Flutter client, IDE/OS
# ============================================================

# ---------- Secrets / environment (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Python / FastAPI backend ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
.installed.cfg
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Alembic: keep versions/ and env.py, but ignore any local scratch
# (nothing to ignore by default — migrations ARE tracked)

# ---------- Flutter / Dart client ----------
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.packages
client/build/
client/.pub-cache/
client/.pub/
client/pubspec.lock        # app repo: optional to ignore; keep if you want reproducible builds

# Generated localization output (regenerated by `flutter gen-l10n`)
client/lib/l10n/app_localizations*.dart

# Flutter platform build artifacts
client/android/.gradle/
client/android/app/debug/
client/android/app/profile/
client/android/app/release/
client/android/local.properties
client/android/key.properties
client/android/**/GeneratedPluginRegistrant.*
client/ios/Flutter/Flutter.framework
client/ios/Flutter/Flutter.podspec
client/ios/Pods/
client/ios/.symlinks/
client/**/*.g.dart.lock
client/web/build/

# ---------- Docker ----------
# (compose file IS tracked; ignore local overrides & volumes if any)
docker-compose.override.yml

# ---------- IDE / editors ----------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/